# Copy this file to .env and fill in the placeholders below.
# Every field here is required by config.py::Settings at startup unless noted otherwise.

### Telethon (user-session scraper) ###
# Get these from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
# Phone number tied to the Telegram account used for scraping (international format).
TELEGRAM_PHONE=+1234567890

### Telegram bot (python-telegram-bot) ###
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Optional. Proxy for Telegram traffic only (Telethon scraper + bot); the LLM
# endpoint and Postgres always connect directly. Leave blank/unset for a direct
# connection. Point at a local SOCKS inbound, e.g. a v2ray/xray client:
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
TELEGRAM_PROXY_URL=

### Database ###
# PostgreSQL connection string. The database is created automatically on
# first run if it doesn't exist yet (see db/engine.py).
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/telegram_scraper

### Channels to scrape ###
# JSON array of channel usernames (with @).
TELEGRAM_CHANNELS=["@example_channel_1","@example_channel_2"]

### Scheduler intervals (minutes) ###
FETCH_INTERVAL_MINUTES=10
EVALUATE_INTERVAL_MINUTES=10
FORWARD_INTERVAL_MINUTES=10

##### SCORING #####
# OpenAI-compatible LLM endpoint used to score messages against resumes
# (via the OpenAI Agents SDK). Any OpenAI-compatible provider works.
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
SCORING_MODEL=gpt-4o-mini

# How many messages to send to the LLM per scoring call.
SCORING_BATCH_SIZE=10
# How many scoring batches to run concurrently.
SCORING_MAX_CONCURRENT=1

# Minimum score (0-10) a message must reach before it's forwarded to the user.
FORWARD_SCORE_THRESHOLD=6
# How many messages to forward concurrently.
FORWARD_MAX_CONCURRENT=2
