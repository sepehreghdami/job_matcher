TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/telegram_scraper
TELEGRAM_CHANNELS=["@channel_one","@channel_two"]

# Optional proxy for Telegram traffic only (Telethon scraper + bot).
# The LLM endpoint and Postgres always connect directly. Unset = no proxy.
# e.g. a v2ray/xray local SOCKS inbound: socks5://127.0.0.1:10808
TELEGRAM_PROXY_URL=

FETCH_INTERVAL_MINUTES=1
EVALUATE_INTERVAL_MINUTES=1
FORWARD_INTERVAL_MINUTES=1

#####SCORING#####
SCORING_BATCH_SIZE=10
SCORING_MAX_CONCURRENT=2
SCORING_MODEL=
FORWARD_SCORE_THRESHOLD=5
FORWARD_MAX_CONCURRENT=2

# OpenAI-compatible endpoint used for scoring (supports non-OpenAI providers).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
